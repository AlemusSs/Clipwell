<Window x:Class="Clipwell.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipwell"
        Width="280"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#F3F3F3"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#99000000" CornerRadius="2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="White" CornerRadius="4" Margin="0,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PinButton" TargetType="Button">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#616161"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Content" Value="&#xE718;"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Opacity" Value="1"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Pinned}" Value="True">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="Foreground" Value="#0078D4"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ClipTemplate">
      <Grid Height="30">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding PreviewText}"
                   Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"
                   Margin="8,0,0,0" VerticalAlignment="Center"
                   FontSize="12" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
        <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
          <Image Source="{Binding Thumbnail}" Width="36" Height="22" Stretch="UniformToFill" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding ImageCaption}" FontSize="12" Foreground="#1A1A1A" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource PinButton}" Click="Pin_Click"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <StackPanel>
    <Border x:Name="PinnedBlock" Background="#F3F3F3" BorderBrush="#D1D1D1" BorderThickness="1"
            CornerRadius="8" Padding="4" Margin="0,0,0,6" Visibility="Collapsed">
      <ListBox x:Name="PinnedList"
               MaxHeight="164"
               BorderThickness="0"
               Background="Transparent"
               FocusVisualStyle="{x:Null}"
               ItemTemplate="{StaticResource ClipTemplate}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectionChanged="List_SelectionChanged"/>
    </Border>

    <Border x:Name="HistoryBlock" Background="#F3F3F3" BorderBrush="#D1D1D1" BorderThickness="1"
            CornerRadius="8" Padding="4">
      <ListBox x:Name="HistoryList"
               MaxHeight="164"
               BorderThickness="0"
               Background="Transparent"
               FocusVisualStyle="{x:Null}"
               ItemTemplate="{StaticResource ClipTemplate}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectionChanged="List_SelectionChanged"/>
    </Border>
  </StackPanel>
</Window>
