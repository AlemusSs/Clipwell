<Window x:Class="Clipwell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#F3F3F3"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="RowText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D1D1D1"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Panel" Background="#F3F3F3" BorderBrush="#D1D1D1" BorderThickness="1" CornerRadius="8" Padding="4">
    <StackPanel>
      <Grid Margin="12,6,6,6" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <TextBlock Text="Настройки" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A" VerticalAlignment="Center"/>
        <Button Content="×" HorizontalAlignment="Right" FontSize="16" Width="28" Height="26"
                Background="Transparent" BorderThickness="0" Click="Close_Click"/>
      </Grid>

      <Grid Margin="12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource RowText}" Text="Горячая клавиша"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Border Background="White" BorderBrush="#D1D1D1" BorderThickness="1" CornerRadius="4" Padding="8,3">
            <TextBlock x:Name="HotkeyText" FontSize="12" Foreground="#1A1A1A"/>
          </Border>
          <Button x:Name="HotkeyButton" Content="Изменить" Style="{StaticResource SmallButton}" Click="HotkeyButton_Click"/>
        </StackPanel>
      </Grid>

      <Grid Margin="12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource RowText}" Text="Запускать вместе с Windows"/>
        <CheckBox x:Name="AutostartBox" Grid.Column="1" VerticalAlignment="Center" Click="AutostartBox_Click"/>
      </Grid>

      <Grid Margin="12,0,12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource RowText}" Text="Запускать скрыто в трее при включении ПК" TextWrapping="Wrap"/>
        <CheckBox x:Name="HiddenBox" Grid.Column="1" VerticalAlignment="Center" Click="HiddenBox_Click"/>
      </Grid>

      <Grid Margin="12,8,12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource RowText}" Text="Открывать меню даже без курсора" TextWrapping="Wrap"/>
        <CheckBox x:Name="AlwaysOpenBox" Grid.Column="1" VerticalAlignment="Center" Click="AlwaysOpenBox_Click"/>
      </Grid>

      <Grid Margin="12,8,12,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource RowText}" Text="Записей в истории"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="−" Style="{StaticResource SmallButton}" Margin="0" Width="28" Click="Minus_Click"/>
          <Border Background="White" BorderBrush="#D1D1D1" BorderThickness="1" CornerRadius="4" Width="40" Margin="6,0,0,0">
            <TextBlock x:Name="LimitText" FontSize="13" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Button Content="+" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Width="28" Click="Plus_Click"/>
        </StackPanel>
      </Grid>
      <TextBlock Text="От 5 до 50, шаг 5. Лишние старые записи удаляются."
                 FontSize="11" Foreground="#616161" Margin="12,0,12,10" TextWrapping="Wrap"/>

      <Grid Margin="12,8,12,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource RowText}" Text="Очистить историю"/>
        <Button Grid.Column="1" Content="Очистить" Style="{StaticResource SmallButton}" Margin="0"
                Foreground="#A4262C" Click="Clear_Click"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
